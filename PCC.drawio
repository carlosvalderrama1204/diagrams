        <mxCell id="cCGhtzmz6kHL7kqDaqFb-20" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;ol start=&quot;1&quot; type=&quot;1&quot; style=&quot;box-sizing: border-box; padding-left: 40px; color: rgb(0, 0, 0); font-family: &amp;quot;Segoe UI VSS (Regular)&amp;quot;, &amp;quot;Segoe UI&amp;quot;, -apple-system, BlinkMacSystemFont, Roboto, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Ubuntu, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; margin-bottom: 0cm; margin-top: 0cm;&quot;&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;&lt;b style=&quot;box-sizing: border-box;&quot;&gt;Material inactivo / borrado en SAP&lt;/b&gt;&lt;/li&gt;&lt;ul style=&quot;box-sizing: border-box; padding: 0px 0px 0px 40px; margin-bottom: 0cm; margin-top: 0cm;&quot;&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;Si&amp;nbsp;estadoBienProducto&amp;nbsp;corresponde a alguno de los valores configurados como “inactivo/borrado” (ej.&amp;nbsp;BORRADO,&amp;nbsp;INACTIVO, equivalentes al flag de borrado del ERP):&lt;/li&gt;&lt;ul style=&quot;box-sizing: border-box; padding: 0px 0px 0px 40px; margin-bottom: 0cm; margin-top: 0cm;&quot;&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;fechaValidez&amp;nbsp;= fecha anterior a la fecha actual (por ejemplo hoy - 1 día).&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;fechaValidezPrecio&amp;nbsp;=&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; display: inline !important;&quot;&gt;fecha anterior a la fecha actual (por ejemplo hoy - 1 día).&lt;/span&gt;.&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;Efecto: PCC oculta globalmente el producto.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;&lt;b style=&quot;box-sizing: border-box;&quot;&gt;Material bloqueado para compra pero vigente&lt;/b&gt;&lt;/li&gt;&lt;ul style=&quot;box-sizing: border-box; padding: 0px 0px 0px 40px; margin-bottom: 0cm; margin-top: 0cm;&quot;&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;Si&amp;nbsp;bloqueoCompra&amp;nbsp;está en la lista de estados “bloqueado” y&amp;nbsp;estadoBienProducto&amp;nbsp;es activo:&lt;/li&gt;&lt;ul style=&quot;box-sizing: border-box; padding: 0px 0px 0px 40px; margin-bottom: 0cm; margin-top: 0cm;&quot;&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;fechaValidez&amp;nbsp;=&amp;nbsp;fechaFin&amp;nbsp;(mantiene vigencia global del producto).&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;fechaValidezPrecio&amp;nbsp;= fecha anterior a la actual.&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;Efecto: PCC mantiene el producto visible pero sin precio vigente para el proveedor (no se puede comprar).&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;&lt;b style=&quot;box-sizing: border-box;&quot;&gt;Material activo sin bloqueo&lt;/b&gt;&lt;/li&gt;&lt;ul style=&quot;box-sizing: border-box; padding: 0px 0px 0px 40px; margin-bottom: 0cm; margin-top: 0cm;&quot;&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;Si ni&amp;nbsp;estadoBienProducto&amp;nbsp;ni&amp;nbsp;bloqueoCompra&amp;nbsp;indican restricción:&lt;/li&gt;&lt;ul style=&quot;box-sizing: border-box; padding: 0px 0px 0px 40px; margin-bottom: 0cm; margin-top: 0cm;&quot;&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;fechaValidez&amp;nbsp;=&amp;nbsp;fechaFin&amp;nbsp;enviada por SAP.&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box; list-style: inherit; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;fechaValidezPrecio&amp;nbsp;=&amp;nbsp;fechaFin&amp;nbsp;enviada por SAP.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/ol&gt;&lt;p style=&quot;box-sizing: border-box; color: rgb(0, 0, 0); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; margin: 0cm 0cm 8pt; font-size: 11pt; font-family: Aptos, sans-serif;&quot;&gt;Las listas de estados (ESTADOS_INACTIVO,&amp;nbsp;ESTADOS_BLOQUEO_COMPRA) deben ser parametrizables.&lt;/p&gt;" vertex="1">
          <mxGeometry height="610" width="560" x="1320" y="1230" as="geometry" />
        </mxCell>
